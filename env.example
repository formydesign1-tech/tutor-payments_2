# Пароль для входа на сайт (обязательно)
APP_PASSWORD=придумай-длинный-пароль
# Папка с данными. На Railway укажи путь к Volume, например /data
DATA_DIR=./data
# Необязательно: ключ подписи сессий. Если не задан, берётся из пароля
# SESSION_SECRET=
# Порт задаёт Railway сам, локально по умолчанию 3000
# PORT=3000
